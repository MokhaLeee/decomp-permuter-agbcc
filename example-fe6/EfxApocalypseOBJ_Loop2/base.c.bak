#include "include.h"

void EfxApocalypseOBJ_Loop2(struct ProcEfxOBJ *proc)
{
	struct BaSprite *sprite = proc->anim2;
	int zero;
	short interp = Interpolate(0, 0xB4, 0x32, proc->timer, 0x3C);
	unsigned oldAngle = proc->unk30;
	register unsigned angle asm("r1") = oldAngle + 0x300;
	register unsigned index asm("r2");
	short xSin;
	short ySin;
	int x;
	int y;
	int xPos;
	int yPos;

	zero = 0;
	proc->unk30 = angle;
	index = angle >> 8;
	xSin = gSinLut[index];
	ySin = gSinLut[index + 0x40];
	x = (xSin * (short)interp) << 4;
	y = ((short)interp * ySin) << 4;
	xPos = proc->unk32 + (x >> 16);
	yPos = proc->unk3A + (y >> 16);
	sprite->xPosition = xPos;
	sprite->yPosition = yPos;

	proc->timer++;
	if (proc->timer > 0x3C)
		proc->timer = 0x3C;

	proc->terminator++;
	if (proc->terminator > 0x78) {
		proc->timer = zero;
		proc->terminator = zero;
		Proc_Break(proc);
	}
}
